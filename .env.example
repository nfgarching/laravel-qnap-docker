# Werte dieser Installation für docker-compose.yaml, die nginx-Vorlage und
# docker/certs/make-certs.sh. Als .env kopieren und anpassen.
# Die Laravel-Konfiguration steht getrennt davon in src/.env.

# Öffentlicher DNS-Name der App (A-Eintrag auf LAN_IP, Let's Encrypt per DNS-01).
APP_DOMAIN=laravel.example.com
# Port auf der NAS-IP, über den nur /api/webhooks/* erreichbar ist (nginx: listen 8080).
APP_PORT=8026

# Eigene LAN-IP des Webservers (QNAP-Treiber qnet, Bridge auf LAN_IFACE).
LAN_IFACE=eth0
LAN_SUBNET=192.168.178.0/24
LAN_GATEWAY=192.168.178.1
LAN_IP=192.168.178.100
# Feste, lokal verwaltete MAC (02:42 + IP in Hex), damit der Router das Gerät wiedererkennt.
LAN_MAC=02:42:c0:a8:b2:64
# Netze, deren Antworten über LAN_GATEWAY statt über die Docker-Bridge gehen (z. B. VPN).
LAN_ROUTES=192.168.0.0/16

# Weitere Namen/IPs, die per https auf APP_DOMAIN umgeleitet werden (Zertifikat der
# internen CA, docker/certs/make-certs.sh). Der erste Eintrag ist der CN des Zertifikats.
NGINX_REDIRECT_HOSTS="laravel laravel.fritz.box 192.168.178.100"

# Let's Encrypt (lego) per acme-dns.
ACME_EMAIL=admin@example.com
ACME_DNS_API_BASE=https://auth.acme-dns.io

# Organisation im Namen der internen CA.
CA_NAME="Beispiel GmbH"

# Namen von Image, Containern (<Präfix>_app, _web, …) und Redis-Volume.
APP_IMAGE=laravel-qnap-app
CONTAINER_PREFIX=laravel
REDIS_VOLUME=laravel-redis
# UID/GID des Besitzers von src/ (id -u / id -g): www-data im Image und lego laufen damit.
HOST_UID=1000
HOST_GID=100
